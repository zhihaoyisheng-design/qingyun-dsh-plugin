{
  "name": "qingyun-dsh-plugin",
  "version": "0.4.6",
  "description": "青云 QINGYUN：本地 PDF 文字提取/OCR、独立 AI 阅读会话与个人知识沉淀",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zhihaoyisheng-design/qingyun-dsh-plugin.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-workbench",
    "reading",
    "knowledge-management",
    "qingyun"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": [
        "pdfjs-dist/legacy/build/pdf.js",
        "tesseract.js"
      ]
    }
  },
  "dependencies": {
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "5.1.1"
  }
}
